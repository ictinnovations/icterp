<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="plo_compute_view_form" model="ir.ui.view">
        <field name="name">icterp.obe.plo.compute.form</field>
        <field name="model">icterp.obe.plo.compute</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="result_note">
                    <field name="course_id"/>
                    <field name="term_id"/>
                </group>
                <field name="result_note" invisible="not result_note" nolabel="1"/>
                <footer>
                    <button name="action_compute" type="object" string="Compute" class="btn-primary" invisible="result_note"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="plo_compute_action" model="ir.actions.act_window">
        <field name="name">Compute attainment</field>
        <field name="res_model">icterp.obe.plo.compute</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
