<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_clo" model="ir.actions.report">
        <field name="name">CLO attainment report</field>
        <field name="model">icterp.course.offering</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">icterp_edu_obe.report_clo</field>
        <field name="report_file">icterp_edu_obe.report_clo</field>
        <field name="print_report_name">'CLO attainment - %s' % object.name</field>
        <field name="binding_model_id" ref="icterp_edu_academics.model_icterp_course_offering"/>
        <field name="binding_type">report</field>
    </record>
    <template id="report_clo">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 12px;">
                        <h4>CLO attainment: <t t-out="doc.subject_id.code"/> <t t-out="doc.subject_id.name"/></h4>
                        <p>
                            <t t-out="doc.term_id.name"/>, <t t-out="doc.course_id.name"/> <t t-out="doc.batch_id.name"/> section <t t-out="doc.section"/>.
                            Teacher: <t t-out="doc.faculty_id.name or '-'"/>. Students: <t t-out="doc.enrolled_count"/>.
                        </p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr><th>CLO</th><th>Statement</th><th>Level</th><th>PLOs</th>
                                    <th class="text-end">Assessed</th><th class="text-end">Attained</th><th class="text-end">% students</th>
                                    <th class="text-end">Avg %</th><th class="text-center">Result</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.clo_attainment_ids" t-as="r">
                                    <td t-out="r.clo_id.code"/>
                                    <td t-out="r.clo_id.description"/>
                                    <td t-out="r.level"/>
                                    <td t-out="r.plo_codes"/>
                                    <td class="text-end" t-out="r.students_assessed"/>
                                    <td class="text-end" t-out="r.students_attained"/>
                                    <td class="text-end" t-out="'%.1f' % r.percent_attained"/>
                                    <td class="text-end" t-out="'%.1f' % r.average_percent"/>
                                    <td class="text-center"><strong t-out="'Attained' if r.attained else ('Not attained' if r.students_assessed else 'Not assessed')"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="mt-3">How each CLO was assessed</h6>
                        <table class="table table-sm table-bordered">
                            <thead><tr><th>Assessment</th><th>Question</th><th class="text-end">Marks</th><th>CLO</th></tr></thead>
                            <tbody>
                                <t t-foreach="doc.component_ids" t-as="c">
                                    <t t-if="c.question_ids">
                                        <tr t-foreach="c.question_ids" t-as="q">
                                            <td t-out="c.name"/><td t-out="q.name"/><td class="text-end" t-out="q.max_marks"/><td t-out="q.clo_id.code or '-'"/>
                                        </tr>
                                    </t>
                                    <tr t-else=""><td t-out="c.name"/><td>-</td><td class="text-end" t-out="c.max_marks"/><td t-out="c.clo_id.code or '-'"/></tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="text-muted">A student attains a CLO at the student threshold; the class attains it when enough students do (Settings, Outcome Based Education).</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
