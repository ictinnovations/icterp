<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_obe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.icterp.obe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="openeducat_core.res_config_settings_view_form_core"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='openeducat_core']" position="inside">
                <block title="Outcome Based Education" name="icterp_obe">
                    <setting string="Attainment thresholds" help="Common HEC practice: a student attains at 50%, a class attains when 60% of students do.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="obe_student_threshold" class="col-lg-6 o_light_label"/>
                                <field name="obe_student_threshold"/>
                            </div>
                            <div class="row">
                                <label for="obe_class_threshold" class="col-lg-6 o_light_label"/>
                                <field name="obe_class_threshold"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
