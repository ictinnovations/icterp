<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_academics" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.icterp.academics</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="openeducat_core.res_config_settings_view_form_core"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='openeducat_core']" position="inside">
                <block title="Academic standing (GPA)" name="icterp_academic_standing">
                    <setting string="Standing thresholds" help="Applied to the CGPA after every published term.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="edu_warning_below" class="col-lg-5 o_light_label"/>
                                <field name="edu_warning_below"/>
                            </div>
                            <div class="row">
                                <label for="edu_probation_below" class="col-lg-5 o_light_label"/>
                                <field name="edu_probation_below"/>
                            </div>
                            <div class="row">
                                <label for="edu_suspension_after" class="col-lg-5 o_light_label"/>
                                <field name="edu_suspension_after"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
