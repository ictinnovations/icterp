<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grade_scale_view_form" model="ir.ui.view">
        <field name="name">icterp.grade.scale.form</field>
        <field name="model">icterp.grade.scale</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="active"/></group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="letter"/>
                            <field name="min_percent"/>
                            <field name="points"/>
                            <field name="is_pass"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="grade_scale_view_list" model="ir.ui.view">
        <field name="name">icterp.grade.scale.list</field>
        <field name="model">icterp.grade.scale</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="grade_scale_action" model="ir.actions.act_window">
        <field name="name">Grade scales</field>
        <field name="res_model">icterp.grade.scale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
