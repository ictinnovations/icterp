<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Marks entry: one editable grid, grouped by assessment -->
    <record id="mark_view_list" model="ir.ui.view">
        <field name="name">icterp.assessment.mark.list</field>
        <field name="model">icterp.assessment.mark</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="offering_id" column_invisible="1"/>
                <field name="component_id" domain="[('offering_id', '=', offering_id)]"/>
                <field name="enrollment_id" domain="[('offering_id', '=', offering_id), ('state', 'in', ['enrolled', 'completed'])]"/>
                <field name="marks"/>
                <field name="max_marks"/>
                <field name="absent"/>
                <field name="source" optional="show"/>
            </list>
        </field>
    </record>
    <record id="mark_view_search" model="ir.ui.view">
        <field name="name">icterp.assessment.mark.search</field>
        <field name="model">icterp.assessment.mark</field>
        <field name="arch" type="xml">
            <search>
                <field name="offering_id"/>
                <field name="component_id"/>
                <field name="student_id"/>
                <group>
                    <filter name="by_component" string="Assessment" context="{'group_by': 'component_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="mark_action" model="ir.actions.act_window">
        <field name="name">Marks</field>
        <field name="res_model">icterp.assessment.mark</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_by_component': 1}</field>
    </record>

</odoo>
