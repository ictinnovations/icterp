<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="grade_change_view_form" model="ir.ui.view">
        <field name="name">icterp.grade.change.form</field>
        <field name="model">icterp.grade.change</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="enrollment_id" readonly="1"/>
                    <field name="current_grade"/>
                    <field name="scale_id" invisible="1"/>
                    <field name="new_band_id" options="{'no_create': True}"/>
                    <field name="reason" placeholder="For example: recount of the final exam paper, approved by the exam committee on ..."/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Change grade" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="grade_change_action" model="ir.actions.act_window">
        <field name="name">Change grade</field>
        <field name="res_model">icterp.grade.change</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
