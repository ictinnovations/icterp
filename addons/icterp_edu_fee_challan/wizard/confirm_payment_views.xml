<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="confirm_payment_view_form" model="ir.ui.view">
        <field name="name">icterp.challan.confirm.payment.form</field>
        <field name="model">icterp.challan.confirm.payment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="challan_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="paid_date"/>
                    <field name="fine"/>
                    <field name="due"/>
                    <field name="amount"/>
                    <field name="journal_id" placeholder="Bank journal of the account it was paid into"/>
                    <field name="reference"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm payment" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="confirm_payment_action" model="ir.actions.act_window">
        <field name="name">Confirm payment</field>
        <field name="res_model">icterp.challan.confirm.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
