<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="generate_challans_view_form" model="ir.ui.view">
        <field name="name">icterp.generate.challans.form</field>
        <field name="model">icterp.generate.challans</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="result_note">
                    <group>
                        <field name="batch_id"/>
                        <field name="fees_up_to"/>
                    </group>
                    <group>
                        <field name="issue_date"/>
                        <field name="due_date"/>
                        <field name="issue_now"/>
                    </group>
                </group>
                <field name="student_ids" invisible="result_note"/>
                <field name="result_note" invisible="not result_note" nolabel="1"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary" invisible="result_note"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="generate_challans_action" model="ir.actions.act_window">
        <field name="name">Generate challans</field>
        <field name="res_model">icterp.generate.challans</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
