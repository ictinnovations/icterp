<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_challan" model="ir.ui.view">
        <field name="name">res.company.form.icterp.challan</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fee challans" name="fee_challans">
                    <group>
                        <group>
                            <field name="challan_bank_ids" widget="many2many_tags"/>
                            <field name="challan_fine_policy_id"/>
                            <field name="challan_validity_days"/>
                        </group>
                        <group>
                            <field name="challan_instructions"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
