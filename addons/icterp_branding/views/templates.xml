<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout_title" inherit_id="web.layout">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'ICTERP'"/>
        </xpath>
    </template>
    <template id="webclient_bootstrap_brand" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="attributes">
            <attribute name="content">#1d4ed8</attribute>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="attributes">
            <attribute name="href">/icterp_branding/static/img/icterp-icon-ios.png</attribute>
        </xpath>
    </template>
</odoo>
